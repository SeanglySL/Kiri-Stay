  "content": {
    "hero": {
      "eyebrow": {
        "en": "Est. 2026 — 5-floor independent hotel",
        "km": "បង្កើតឡើងឆ្នាំ ២០២៦ — សណ្ឋាគារឯករាជ្យ ៥ជាន់",
        "zh": "始于2026年 — 五层独立酒店"
      },
      "heading": {
        "en": "A quiet room, booked in under a minute.",
        "km": "បន្ទប់ស្ងប់ស្ងាត់ កក់បានក្នុងរយៈពេលមិនដល់មួយនាទី",
        "zh": "安静的客房，一分钟内即可预订"
      },
      "description": {
        "en": "3 honest room types, a rooftop pool and bar, ground-floor breakfast, free parking, and real-time availability — no phone calls, no waiting for confirmation.",
        "km": "បន្ទប់ 3 ប្រភេទស្មោះត្រង់ អាងហែលទឹក និងបារនៅដំបូល អាហារពេលព្រឹកនៅជាន់ផ្ទាល់ដី ចំណតរថយន្តឥតគិតថ្លៃ និងព័ត៌មានទំនេរជាក់ស្តែង — មិនចាំបាច់ទូរស័ព្ទ មិនចាំបាច់រង់ចាំការបញ្ជាក់ទេ។",
        "zh": "四种诚实的客房类型、屋顶泳池与酒吧、一楼早餐、免费停车，以及实时房态查询——无需电话，无需等待确认。"
      },
      "images": [
        "/images/1786214411884-c628995920.jpg",
        "/images/1786214495031-708ef22657.jpg"
      ]
    },
    "whyKiriStay": {
      "eyebrow": {
        "en": "Why Kiri Stay",
        "km": "ហេតុអ្វីជ្រើសរើស Kiri Stay",
        "zh": "为什么选择Kiri Stay"
      },
      "heading": {
        "en": "Built like a ledger, not a leaflet",
        "km": "សាងសង់ដូចជាបញ្ជីគណនេយ្យ មិនមែនខិត្តប័ណ្ណផ្សព្វផ្សាយ",
        "zh": "如账本般严谨，而非宣传单页"
      },
